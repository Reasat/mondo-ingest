# Mondo pipeline — TARGET split
# Rule: non-alignment (source formatting, metrics, xref export, version docs) -> source repos.
#       mondo-ingest: alignment only (lexmatch, slurp, sync, metadata config, QC sandbox).
# [A] auto  [M] manual  [R] review gate  [M-A] could automate

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

*.style.font-size: 14

classes: {
  auto: {
    style.fill: "#c8e6c9"
    style.stroke: "#2e7d32"
  }
  manual: {
    style.fill: "#ffe0b2"
    style.stroke: "#e65100"
  }
  review: {
    style.fill: "#fff9c4"
    style.stroke: "#f9a825"
  }
  ma: {
    style.fill: "#e1bee7"
    style.stroke: "#7b1fa2"
  }
  moved: {
    style.fill: "#f1f8e9"
    style.stroke: "#558b2f"
  }
}

# =========================================================
# SOURCE REPOS — all non-alignment work (per source, independent)
# =========================================================
srcrepos: {
  label: "source ontology repos  (per source, independent)"
  style.fill: "#fff9e6"
  style.font-size: 26
  style.bold: true
  direction: down

  note: {
    label: "monarch-initiative/ omim · icd11 · icd10who · icd10cm · ordo · ncit · doid"
    style.fill: "#fff3cc"
    style.font-size: 16
    style.bold: true
  }

  prep: {
    label: "preprocessing + release assets"
    style.fill: "#fff3cc"
    style.font-size: 20
    style.bold: true
    direction: down

    s1: { class: moved; label: "[A] build component.owl (ROBOT transform)" }
    s2: { class: moved; label: "[A] mirror.owl" }
    s3: { class: moved; label: "[A] semsql -> component.db" }
    s4: { class: moved; label: "[A] signatures (mirror vs component)" }
    s5: { class: moved; label: "[A] metrics + docs/sources" }
    s6: { class: moved; label: "[A] mappings/source.sssom.tsv\n(xref export from component)" }
    s7: { class: moved; label: "[A] source-versions\n(upstream release metadata)" }
  }
}

# =========================================================
# AUX INPUTS — not owned by any single source repo
# =========================================================
aux: {
  label: "aux inputs & mondo clone"
  style.fill: "#fff9e6"
  style.font-size: 26
  style.bold: true
  direction: down

  emc: {
    label: "EMC & aux inputs"
    style.fill: "#fff3cc"
    style.font-size: 18
    style.bold: true
    text: |md
      GARD · NORD · EFO · medgen
      MalaCards · ClinGen · omim TSVs
    |
  }

  reject: { class: manual; label: "[M] rejected-mappings.tsv\n(Google Sheet — alignment curation)" }

  mrepo: {
    label: "monarch-initiative/mondo"
    style.fill: "#fff3cc"
    style.font-size: 18
    style.bold: true
    text: |md
      cloned at build time
      -> tmp/mondo.owl + mondo.sssom.tsv
    |
  }
}

# =========================================================
# MONDO-INGEST — ALIGNMENT ONLY
# =========================================================
ingest: {
  label: "mondo-ingest  (ALIGNMENT ONLY)"
  style.fill: "#e8f4ff"
  style.font-size: 26
  style.bold: true
  direction: right

  align: {
    label: "align  (diff each source vs Mondo)"
    style.fill: "#e3f2fd"
    style.font-size: 20
    style.bold: true
    direction: down

    g1: { class: auto; label: "[A] clone mondo -> tmp/" }
    m2: { class: manual; label: "[M] metadata/source.yml\n(alignment script config)" }
    x1: { class: manual; label: "[M] config/*_exclusions.tsv\n(alignment curation)" }
    i2: { class: auto; label: "[A] mapping status + unmapped reports" }
    i4: { class: auto; label: "[A] slurp/*.tsv generation" }
    i5: { class: review; label: "[R] slurp row review" }
    i6: { class: auto; label: "[A] lexmatch/*.tsv generation" }
    i7: { class: review; label: "[R] lexmatch table triage" }
    i8: { class: auto; label: "[A] subclass sync TSVs" }
    i9: { class: auto; label: "[A] synonym sync TSVs" }
    i10: { class: auto; label: "[A] deprecated-mapped TSVs" }
    i11: { class: auto; label: "[A] EMC -> external/processed-*.owl" }
    m3: { class: manual; label: "[M] nando-mondo.sssom (hand-curated)" }
  }

  publish: {
    label: "publish"
    style.fill: "#e3f2fd"
    style.font-size: 20
    style.bold: true
    direction: down

    p1: { class: auto; label: "[A] prepare_release -> mondo-ingest.owl\n(QC sandbox · merged.db)" }
    p3: { class: auto; label: "[A] tmp/mondo-labels.tsv" }
    p4: { class: ma; label: "[M-A] commit reviewed TSVs to main" }
    p5: { class: ma; label: "[M-A] deploy-mondo-ingest (GH release)" }
  }

  align -> publish
}

# =========================================================
# MONDO — apply proposals + release
# =========================================================
mondo: {
  label: "mondo"
  style.fill: "#d4edda"
  style.font-size: 26
  style.bold: true
  direction: down

  apply: {
    label: "mondo-edit.owl — apply proposals"
    style.fill: "#e8f5e9"
    style.font-size: 20
    style.bold: true
    direction: down

    e1: { class: ma; label: "[M-A] slurp ROBOT merge" }
    e2: { class: manual; label: "[M] curator Protege edits" }
    e3: { class: auto; label: "[A] lex_exact -> auto PR" }
    e4: { class: auto; label: "[A] subclass sync -> auto PR" }
    e5: { class: auto; label: "[A] synonym sync -> auto PR" }
    e6: { class: auto; label: "[A] EMC robot merge" }
    e7: { class: auto; label: "[A] deprecated xref update" }
  }

  artifacts: {
    class: auto
    label: "release outputs"
    style.font-size: 18
    style.bold: true
    text: |md
      [A] mondo.owl · mondo.obo
      [A] mappings/mondo.sssom.tsv
    |
  }

  apply -> artifacts
}

downstream: {
  label: "downstream"
  style.fill: "#e8f5e9"
  style.font-size: 26
  style.bold: true
  direction: down

  consumers: {
    class: auto
    label: "registries & consumers"
    style.font-size: 18
    style.bold: true
    text: |md
      [A] OBO Foundry · OLS · BioPortal · PURL
      [A] ubergraph · Mondo website · SSSOM users
    |
  }
}

changes: {
  label: "repo split summary"
  style.fill: "#f1f8e9"
  style.font-size: 20
  style.bold: true
  direction: down
  text: |md
    SOURCE REPOS release (wget-only into mondo-ingest):
      component.owl · mirror · component.db
      signatures · metrics · docs/sources
      source.sssom.tsv · source-versions
    MONDO-INGEST (alignment):
      metadata/source.yml · exclusions config
      mapping status · lexmatch · slurp · sync · deprecated · EMC
      mondo-ingest.owl QC sandbox · proposal TSVs on main
    AUX (not per-source): rejected-mappings sheet · EMC inputs · Mondo clone
  |
}

legend: {
  label: "legend"
  style.fill: "#fafafa"
  style.font-size: 20
  style.bold: true
  direction: down
  la: { class: auto; label: "[A] auto — make runs, no human" }
  lr: { class: review; label: "[R] review — human judgment (external, Mondo PRs)" }
  lm: { class: manual; label: "[M] manual — ongoing human curation" }
  lma: { class: ma; label: "[M-A] manual now — could be scripted/CI" }
  lmv: { class: moved; label: "green — lives in source repos (non-alignment)" }
  lfb: {
    style.fill: "#fafafa"
    style.stroke: "#616161"
    style.stroke-dash: 4
    label: "dashed: orange=feedback | purple=main->Mondo CI | blue=next build"
  }
}

# ---------- build-time reads (solid) ----------
srcrepos.prep -> ingest.align: "wget release assets"
aux.emc -> ingest.align.i11: fetch EMC
aux.mrepo -> ingest.align.g1: clone
ingest.align.m2 -> ingest.align.i2: "metadata (read at build)"
ingest.align.x1 -> ingest.align.i2: "exclusions (read at build)"
aux.reject -> ingest.align.i6: "rejected-mappings (read)"

# ---------- curator workflow order (dashed) ----------
ingest.align.i7 -> ingest.align.i5: {
  style.stroke-dash: 5
  style.stroke: "#f9a825"
  label: clear lex first\n(then slurp)
}

# ---------- feedback: review -> exclusions (internal) / reject sheet ----------
ingest.align.i5 -> ingest.align.x1: {
  style.stroke-dash: 5
  style.stroke: "#e65100"
  label: curator PR\n(exclusions)
}
ingest.align.i7 -> ingest.align.x1: {
  style.stroke-dash: 5
  style.stroke: "#e65100"
}
ingest.align.i7 -> aux.reject: {
  style.stroke-dash: 5
  style.stroke: "#e65100"
  label: update reject\nsheet
}
mondo.apply.e2 -> ingest.align.x1: {
  style.stroke-dash: 5
  style.stroke: "#e65100"
}

# ---------- data-quality feedback -> source repos ----------
ingest.align.i2 -> srcrepos.prep: {
  style.stroke-dash: 5
  style.stroke: "#e65100"
  label: data-quality fixes\n(labels · hierarchy · missing terms)
}

# ---------- mondo-ingest main -> Mondo CI wget ----------
ingest.publish.p4 -> mondo.apply: {
  style.stroke-dash: 5
  style.stroke: "#7b1fa2"
  label: mondo-ingest main\n-> Mondo CI wget
}

# ---------- Mondo changes -> next mondo-ingest build ----------
mondo.apply -> ingest.align.g1: {
  style.stroke-dash: 5
  style.stroke: "#1565c0"
  label: next build\nclone mondo
}
mondo.apply -> ingest.align.i2: {
  style.stroke-dash: 5
  style.stroke: "#1565c0"
  label: next build
}
mondo.apply -> ingest.align.i4: {
  style.stroke-dash: 5
  style.stroke: "#1565c0"
  label: next build\nfewer slurp rows
}

# ---------- proposals + downstream ----------
ingest.align -> mondo.apply: proposals (reviewed)
ingest.publish.p1 -> mondo.apply: QC sandbox
ingest.publish.p3 -> mondo.artifacts: labels
mondo.artifacts -> downstream.consumers: releases
